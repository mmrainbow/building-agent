# 默认忽略根目录下所有内容，只上传白名单中的项目
/*

# 允许上传的根目录文件 / 文件夹
!/.gitignore
!/backend/
!/frontend/
!/model-finetuning/
!/AGENT.md
!/DEVELOPMENT_PLAN.md
!/README.md

# ── 全局临时文件 ──
__pycache__/
*.py[cod]
*.log
*.db
*.sqlite
.idea/
.claude/
.gradio/

# ── 前端构建产物 ──
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── 后端敏感 / 大文件 ──
backend/.env
backend/model_weights/*.pt
backend/model_weights/*.pth
backend/qwen2_5_vl_3b_building_merged/*.safetensors
backend/qwen2_5_vl_3b_building_merged/model.safetensors.index.json
backend/chroma_db/
backend/rag_data/
backend/chat_images/
backend/inspection.db
backend/outputs/

# ── 模型微调模块：只提交代码和文档，不提交数据、结果、权重、本机配置 ──
model-finetuning/.env
model-finetuning/*.env
model-finetuning/data/
model-finetuning/results/
model-finetuning/reports/
model-finetuning/outputs/
model-finetuning/output/
model-finetuning/dataset-builder/output/
model-finetuning/dataset-builder/config/config.json
model-finetuning/**/*.pt
model-finetuning/**/*.pth
model-finetuning/**/*.bin
model-finetuning/**/*.safetensors
model-finetuning/**/*.gguf
model-finetuning/**/*.onnx
model-finetuning/**/checkpoint-*/
model-finetuning/**/*_merged/
