# 默认忽略根目录下所有内容，只上传下面白名单中的项目
/*

# 允许上传的根目录文件 / 文件夹
!/.gitignore
!/backend/
!/frontend/
!/AGENT.md
!/DEVELOPMENT_PLAN.md
!/README.md

# ── 全局临时文件 ──
__pycache__/
*.py[cod]
*.log
*.db
*.sqlite
.idea/
.claude/
.gradio/

# ── 前端构建产物 ──
frontend/node_modules/
frontend/dist/

# ── 后端敏感 / 大文件 ──
backend/.env
backend/model_weights/*.pt
backend/model_weights/*.pth
backend/qwen2_5_vl_3b_building_merged/*.safetensors
backend/qwen2_5_vl_3b_building_merged/model.safetensors.index.json
backend/chroma_db/
backend/rag_data/
backend/chat_images/
backend/inspection.db
backend/outputs/
frontend/.vite/
